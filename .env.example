# Senha para logar NESTE app web (escolha a sua)
APP_PASSWORD=troque-esta-senha

# Chave aleatória para assinar a sessão do app (pode gerar qualquer string longa)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Credenciais da API do Snov.io (conta > API)
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# Opcional: Upstash Redis (upstash.com, plano free) para guardar de forma
# permanente quais respostas já foram marcadas como "respondido". Sem isso,
# o app usa um arquivo local que é apagado sempre que o servidor reinicia.
# Pegue essas duas variáveis no dashboard do Upstash > seu banco > REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=3000
